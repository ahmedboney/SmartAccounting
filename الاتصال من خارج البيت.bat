@echo off
chcp 65001 >nul
title الاتصال بنظام المحاسبة من خارج البيت
echo.
echo   ==================================================
echo    الاتصال بالنظام المحاسبي من جهاز خارج البيت
echo   ==================================================
echo.
echo اكتب عنوان الوصول اللي وصلّك من الجهاز الرئيسي ثم Enter:
echo.
echo    مثال (DDNS — رابط ثابت لا يتغير):
echo        http://myoffice.duckdns.org:5000
echo.
echo    مثال (عنوان IPv4 عام — يتغير كل فترة):
echo        http://123.123.123.123:5000
echo.
echo    مثال (جهاز داخل نفس الراوتر):
echo        http://192.168.1.5:5000
echo.
echo   ⚠️ الرابط مش بيفتح غير لو المنفذ 5000 متفتح في الراوتر
echo      (راجع: دليل الربط من خارج البيت.txt)
echo.
set /p LINK=عنوان الوصول: 
if "%LINK%"=="" (
  echo.
  echo لم تكتب عنواناً - الخروج.
  timeout /t 2 /nobreak >nul
  exit /b
)
start "" "%LINK%"